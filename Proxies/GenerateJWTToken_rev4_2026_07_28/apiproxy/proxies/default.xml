<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <!-- مسار الطلب: جلب المفتاح وتوليد التوكن -->
    <Request>
      <Step>
        <Name>KVM-GetPrivateKey</Name>
      </Step>
      <Step>
        <Name>JWT-GenerateToken</Name>
      </Step>
    </Request>
    <!-- مسار الاستجابة: إرجاع التوكن بصيغة JSON -->
    <Response>
      <Step>
        <Name>AM-ReturnJWT</Name>
      </Step>
    </Response>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/generate_token</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="NoRoute"/>
</ProxyEndpoint>
