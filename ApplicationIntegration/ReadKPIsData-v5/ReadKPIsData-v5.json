    "parameters": {
      "executeQueryRequestConfig": {
        "key": "executeQueryRequestConfig",
        "value": {
          "jsonValue": "{\n  \"@type\": \"type.googleapis.com/enterprise.crm.eventbus.proto.connectors.ExecuteQueryRequestConfig\",\n  \"query\": {\n    \"literalValue\": {\n      \"stringValue\": \"SELECT\\r\\n    kd.kpi_code,\\r\\n    kd.KPI_Name,\\r\\n    kd.KPI_Description,\\r\\n    kc.Name_En,\\r\\n\\r\\n    kv.Report_Year,\\r\\n    kv.Report_Month,\\r\\n    kv.Report_Quarter,\\r\\n\\r\\n    kv.SAR_KPI_Value AS KPI_Value,\\r\\n    kv.Unit,\\r\\n    kv.Network,\\r\\n    kv.Creation_Date,\\r\\n\\r\\n    s.Name_En,\\r\\n    tm.Name_En AS Transport_Mode,\\r\\n    tl.Name_En AS Train_Line\\r\\n\\r\\nFROM SAR_KPI_Value kv\\r\\n\\r\\nINNER JOIN SAR_KPI_DEFINITION kd\\r\\n    ON kv.SAR_KPI_Definition_Id \\u003d kd.Id\\r\\n\\r\\nINNER JOIN SAR_KPI_Category kc\\r\\n    ON kd.SAR_KPI_Category \\u003d kc.Id\\r\\n\\r\\nLEFT JOIN SAR_KPI_Station s\\r\\n    ON kv.Station_Id \\u003d s.Id\\r\\n\\r\\nLEFT JOIN SAR_KPI_Transport_Mode tm\\r\\n    ON kv.TransportMode_Id \\u003d tm.Id\\r\\n\\r\\nLEFT JOIN SAR_KPI_Train_Line tl\\r\\n    ON kv.TrainLine_Id \\u003d tl.Id\\r\\n\\r\\nWHERE kv.Report_Month \\u003d ?\\r\\n  AND kv.Report_Year \\u003d ?\\r\\n\\r\\nORDER BY kd.KPI_Code;\"\n    }\n  },\n  \"deadlineInSeconds\": {\n    \"literalValue\": {\n      \"intValue\": \"180\"\n    }\n  },\n  \"pageSize\": {\n    \"literalValue\": {\n      \"intValue\": \"25\"\n    }\n  },\n  \"queryParameters\": [{\n    \"entries\": [{\n      \"key\": {\n        \"literalValue\": {\n          \"stringValue\": \"dataType\"\n        }\n      },\n      \"value\": {\n        \"literalValue\": {\n          \"stringValue\": \"NVARCHAR\"\n        }\n      }\n    }, {\n      \"key\": {\n        \"literalValue\": {\n          \"stringValue\": \"value\"\n        }\n      },\n      \"value\": {\n        \"referenceKey\": \"$Month$\"\n      }\n    }]\n  }, {\n    \"entries\": [{\n      \"key\": {\n        \"literalValue\": {\n          \"stringValue\": \"dataType\"\n        }\n      },\n      \"value\": {\n        \"literalValue\": {\n          \"stringValue\": \"NVARCHAR\"\n        }\n      }\n    }, {\n      \"key\": {\n        \"literalValue\": {\n          \"stringValue\": \"value\"\n        }\n      },\n      \"value\": {\n        \"referenceKey\": \"$Year$\"\n      }\n    }]\n  }]\n}"
